# --- Drizzle / Postgres ----------------------------------------------------
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgres://postgres:postgres@localhost:5432/school_profile"

# --- API auth --------------------------------------------------------------
# Bearer token used by scripts and the docs "Try it out" panel for write
# endpoints. The dashboard uses session cookies and does NOT need this.
# Generate with PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Must be at least 16 characters.
API_ADMIN_TOKEN=""

# --- Admin bootstrap (used by `npm run db:seed`) ---------------------------
# Creates the first admin account on seed if it doesn't exist yet.
# After bootstrap, additional users are managed in the database.
BOOTSTRAP_ADMIN_EMAIL="admin@smp1anggana.local"
BOOTSTRAP_ADMIN_PASSWORD="change-me-please-12chars-minimum"
BOOTSTRAP_ADMIN_NAME="Administrator"

# --- Vite dev server ------------------------------------------------------
# Comma-separated list of allowed hosts for the Vite dev server.
# Example: "localhost,127.0.0.1,example.com"
VITE_ALLOWED_HOSTS="localhost,127.0.0.1"
